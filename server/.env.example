# Copy these into your hosting provider's environment settings
# (the server reads real environment variables; it does not load .env files by itself).

PORT=3001

# Generate with: npm run keys   (inside the server folder)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Your contact, sent to Apple/Google push services. mailto: or https:// only.
VAPID_SUBJECT=mailto:you@example.com

# Create a dedicated bot with @BotFather. Keep the token server-side only.
TELEGRAM_BOT_TOKEN=
# Optional: avoids a getMe lookup when generating app linking URLs.
TELEGRAM_BOT_USERNAME=

# Where db.json lives. Point this at a persistent disk/volume on your host.
DATA_DIR=./data

# Safety cap on how many devices can register (default 50)
MAX_DEVICES=50
